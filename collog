#!/usr/bin/env python3
"""collog: プロジェクト横断のSUMMARY/CHANGES/TODOをSQLiteで一元管理するCLI。

- entries テーブル: SUMMARY/CHANGESを kind 列で区別して保持する追記専用ログ
- todos テーブル: 完了マーク(UPDATE)が発生するため別テーブル

日時はすべてこのスクリプトが自動生成する（呼び出し側が書式を指定する余地を作らない）。
"""
import argparse
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime

__version__ = "1.1.0"
__version_date__ = "2026-10-08"   # 上記バージョン番号の更新日（手動更新）

DEFAULT_DB_PATH = os.path.expanduser("~/.collog/collog.db")


def db_path():
    return os.environ.get("COLLOG_DB", DEFAULT_DB_PATH)


def get_conn():
    path = db_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    conn = sqlite3.connect(path)
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute(
        """CREATE TABLE IF NOT EXISTS entries (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            project TEXT NOT NULL,
            kind TEXT NOT NULL CHECK (kind IN ('summary', 'change')),
            created_at TEXT NOT NULL,
            body TEXT NOT NULL
        )"""
    )
    conn.execute(
        """CREATE TABLE IF NOT EXISTS todos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            project TEXT NOT NULL,
            created_at TEXT NOT NULL,
            completed_at TEXT,
            from_project TEXT,
            body TEXT NOT NULL
        )"""
    )
    # 既存DB向けマイグレーション: from_project列が無ければ追加（requestコマンド対応）。
    existing_cols = {row[1] for row in conn.execute("PRAGMA table_info(todos)")}
    if "from_project" not in existing_cols:
        conn.execute("ALTER TABLE todos ADD COLUMN from_project TEXT")
    # 既存DB向けマイグレーション: declined_at/decline_reason列（declineコマンド対応）。
    if "declined_at" not in existing_cols:
        conn.execute("ALTER TABLE todos ADD COLUMN declined_at TEXT")
        conn.execute("ALTER TABLE todos ADD COLUMN decline_reason TEXT")
    conn.execute(
        """CREATE TABLE IF NOT EXISTS projects (
            name TEXT PRIMARY KEY,
            path TEXT,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL
        )"""
    )
    conn.execute(
        """CREATE TABLE IF NOT EXISTS messages (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            project TEXT NOT NULL,
            from_project TEXT,
            created_at TEXT NOT NULL,
            read_at TEXT,
            body TEXT NOT NULL
        )"""
    )
    return conn


def now():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def resolve_timestamp(at):
    """--at が指定されていればそれを検証して使う。未指定ならnow()。

    過去分の遡及登録（インポート等）のための抜け道だが、自由記述を許すと
    「日時のはずが日付だけ」のような書式崩れが再発するため、フォーマットを
    厳格に検証する。
    """
    if at is None:
        return now()
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            dt = datetime.strptime(at, fmt)
            return dt.strftime("%Y-%m-%d %H:%M:%S")
        except ValueError:
            continue
    print(
        f"エラー: --at の日時形式が不正です: '{at}' "
        f"（'YYYY-MM-DD HH:MM' または 'YYYY-MM-DD HH:MM:SS' で指定してください）",
        file=sys.stderr,
    )
    sys.exit(1)


def validate_date(date_str):
    """--dateの日付形式を検証し、'YYYY-MM-DD'（ゼロパディングあり）に正規化して返す。

    created_atとの比較は単純な文字列完全一致（substr(created_at,1,10) = ?）のため、
    '2026-9-18'のようなゼロパディング無しの入力をそのまま返すと、DB側の
    '2026-09-18'と一致せず、エラーも出ないまま黙って「該当なし」になってしまう。
    resolve_timestamp()と同様、strftimeで正規化してから返す。区切り文字は'-'と'/'を
    許容する（ゼロパディング無しはstrptimeが元々受け付ける）。Noneならそのまま返す。
    """
    if date_str is None:
        return None
    for fmt in ("%Y-%m-%d", "%Y/%m/%d"):
        try:
            dt = datetime.strptime(date_str, fmt)
            return dt.strftime("%Y-%m-%d")
        except ValueError:
            continue
    print(
        f"エラー: --date の日付形式が不正です: '{date_str}' "
        f"（'YYYY-MM-DD'または'YYYY/MM/DD'で指定してください）",
        file=sys.stderr,
    )
    sys.exit(1)


def validate_boundary_timestamp(ts, label):
    """--from/--toの日時境界を検証し、'YYYY-MM-DD HH:MM:SS'に正規化して返す。

    --atと違い、日付のみの指定も許容する（例: --from 2026-09-17 は
    '2026-09-17 00:00:00'として扱われる）。深夜作業を前日扱いにする、といった
    柔軟な範囲指定を想定しているため。区切り文字は'-'と'/'を許容する
    （ゼロパディング無しはstrptimeが元々受け付ける）。Noneならそのまま返す。
    """
    if ts is None:
        return None
    for fmt in (
        "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d",
        "%Y/%m/%d %H:%M:%S", "%Y/%m/%d %H:%M", "%Y/%m/%d",
    ):
        try:
            dt = datetime.strptime(ts, fmt)
            return dt.strftime("%Y-%m-%d %H:%M:%S")
        except ValueError:
            continue
    print(
        f"エラー: {label} の日時形式が不正です: '{ts}' "
        f"（'YYYY-MM-DD'/'YYYY/MM/DD'、または末尾に' HH:MM'/' HH:MM:SS'を"
        f"付けた形式で指定してください）",
        file=sys.stderr,
    )
    sys.exit(1)


def _build_date_filter(date=None, from_ts=None, to_ts=None):
    """created_atに対する絞り込み条件をSQL断片とパラメータのリストとして返す。

    date/from_ts/to_tsは互いに独立した条件として扱われ、複数指定されればAND合成
    される（例: --date と --from/--to を同時指定すれば、その日付かつその時刻範囲、
    という絞り込みになる）。fromは以上、toは未満（半開区間）。
    """
    conditions = []
    params = []
    if date:
        conditions.append("substr(created_at, 1, 10) = ?")
        params.append(date)
    if from_ts:
        conditions.append("created_at >= ?")
        params.append(from_ts)
    if to_ts:
        conditions.append("created_at < ?")
        params.append(to_ts)
    return conditions, params


def read_body():
    body = sys.stdin.read().strip()
    if not body:
        print("エラー: 標準入力から本文を読み込めませんでした（空です）", file=sys.stderr)
        sys.exit(1)
    return body


def validate_body_headings(body):
    """本文が'#'/'##'（collogが自動生成する見出し用に予約）を使っていないか検証する。

    status/recent/changesは本文の前に`## [日時] ...`等の見出しを自動生成するため、
    本文側が同じ階層(#/##)を使うと見出しが二重になり紛らわしい（実例あり）。
    本文は'###'以下のみ使える、というルールで厳格に拒否する。
    """
    for line in body.split("\n"):
        m = re.match(r"^(#{1,2})\s", line)
        if m:
            print(
                f"エラー: 本文に '{m.group(1)}' から始まる見出しが含まれています"
                f"（'{line.strip()[:40]}'）。"
                f"'#'/'##' はcollogが自動生成する見出し用に予約されているため、"
                f"本文では '###' 以下を使ってください。",
                file=sys.stderr,
            )
            sys.exit(1)


def require_registered_project(conn, project):
    row = conn.execute("SELECT 1 FROM projects WHERE name = ?", (project,)).fetchone()
    if row is None:
        print(
            f"エラー: プロジェクト '{project}' は未登録です。"
            f"先に `collog init {project} [パス]` を実行してください。",
            file=sys.stderr,
        )
        sys.exit(1)


def _project_at(dirpath, conn):
    """dirpathと登録パスが完全一致するプロジェクト名を返す。一致が無ければNone。

    配下のサブディレクトリは対象外（親プロジェクトの登録パス配下に未登録の子
    ディレクトリができた場合、誤ってその親にマッチして記録されてしまう事故を避けるため）。
    """
    target = os.path.realpath(os.path.expanduser(dirpath))
    for name, path in conn.execute("SELECT name, path FROM projects WHERE path IS NOT NULL"):
        if target == os.path.realpath(path):
            return name
    return None


def _project_from_cwd(conn):
    """カレントディレクトリから登録済みプロジェクトを推測する。一致が無ければNone。"""
    return _project_at(os.getcwd(), conn)


def _resolve_project(value, conn, label="project"):
    """引数で明示されていればそれを、無ければカレントディレクトリから推測して返す。

    どちらも得られない場合はエラーで終了する。
    """
    if value is not None:
        return value
    detected = _project_from_cwd(conn)
    if detected is None:
        # 「collog initしてください」と誘導すると、既存プロジェクトのサブディレクトリ
        # （配下マッチ廃止により推測できなくなったケース）でも安易に新規initされて
        # しまう恐れがあるため、ここでは明示指定だけを促す（initの提案はしない）。
        print(
            f"エラー: {label}が指定されておらず、カレントディレクトリからも推測できません。"
            f"明示的に指定してください。",
            file=sys.stderr,
        )
        sys.exit(1)
    return detected


def cmd_init(args):
    path = os.path.abspath(args.path) if args.path else os.getcwd()
    conn = get_conn()
    existing = conn.execute(
        "SELECT path FROM projects WHERE name = ?", (args.project,)
    ).fetchone()
    ts = now()
    if existing is None:
        conn.execute(
            "INSERT INTO projects (name, path, created_at, updated_at) VALUES (?, ?, ?, ?)",
            (args.project, path, ts, ts),
        )
        conn.commit()
        print(f"OK: プロジェクト '{args.project}' を登録しました (path: {path})")
    else:
        conn.execute(
            "UPDATE projects SET path = ?, updated_at = ? WHERE name = ?",
            (path, ts, args.project),
        )
        conn.commit()
        if existing[0] != path:
            print(f"OK: プロジェクト '{args.project}' のパスを更新しました ({existing[0]} → {path})")
        else:
            print(f"OK: プロジェクト '{args.project}' は既に登録済みです (path: {path})")
    if not os.path.isdir(path):
        print(f"警告: パス '{path}' はディレクトリとして存在しません", file=sys.stderr)


def cmd_projects(args):
    conn = get_conn()
    rows = conn.execute(
        "SELECT name, path, created_at, updated_at FROM projects ORDER BY name"
    ).fetchall()
    if not rows:
        print("(登録済みプロジェクトはありません)")
        return
    for name, path, created_at, updated_at in rows:
        print(f"{name}\t{path}\t(登録: {created_at} / 更新: {updated_at})")


def cmd_rename(args):
    conn = get_conn()
    old = _resolve_project(args.old_name, conn, "old_name")
    new = args.new_name
    if conn.execute("SELECT 1 FROM projects WHERE name = ?", (old,)).fetchone() is None:
        print(f"エラー: プロジェクト '{old}' は未登録です。", file=sys.stderr)
        sys.exit(1)
    if old == new:
        print("エラー: 変更前後で同じ名前です。", file=sys.stderr)
        sys.exit(1)
    if conn.execute("SELECT 1 FROM projects WHERE name = ?", (new,)).fetchone() is not None:
        print(f"エラー: プロジェクト '{new}' は既に登録されています。", file=sys.stderr)
        sys.exit(1)

    conn.execute(
        "UPDATE projects SET name = ?, updated_at = ? WHERE name = ?", (new, now(), old)
    )
    entries_n = conn.execute(
        "UPDATE entries SET project = ? WHERE project = ?", (new, old)
    ).rowcount
    todos_n = conn.execute(
        "UPDATE todos SET project = ? WHERE project = ?", (new, old)
    ).rowcount
    from_n = conn.execute(
        "UPDATE todos SET from_project = ? WHERE from_project = ?", (new, old)
    ).rowcount
    conn.commit()
    print(
        f"OK: プロジェクト '{old}' を '{new}' にリネームしました "
        f"(entries: {entries_n}件, todos: {todos_n}件, from参照: {from_n}件)"
    )


def cmd_add_entry(args):
    body = read_body()
    validate_body_headings(body)
    conn = get_conn()
    project = _resolve_project(args.project, conn)
    require_registered_project(conn, project)
    conn.execute(
        "INSERT INTO entries (project, kind, created_at, body) VALUES (?, ?, ?, ?)",
        (project, args.kind, resolve_timestamp(args.at), body),
    )
    conn.commit()
    print(f"OK: [{args.kind}] {project} を記録しました")


def _resolve_sender_project(conn, dest_project, from_project_arg):
    """他プロジェクトへの依頼・連絡の送信元(from_project)を解決する。

    明示指定が無ければCWD自動推測を試み、それも失敗すればエラー終了する。
    宛先(dest_project)と送信元が同じ場合もエラーにする。request/messageで共通。
    """
    from_project = from_project_arg
    if from_project is None:
        from_project = _project_from_cwd(conn)
        if from_project is None:
            print(
                "エラー: --fromが指定されておらず、カレントディレクトリからも推測できません。"
                "明示的に --from <project> を指定してください。",
                file=sys.stderr,
            )
            sys.exit(1)
    require_registered_project(conn, from_project)
    if from_project == dest_project:
        print("エラー: 宛先(project)と送信元(--from)が同じプロジェクトです", file=sys.stderr)
        sys.exit(1)
    return from_project


def cmd_add_todo(args):
    body = read_body()
    conn = get_conn()
    project = _resolve_project(args.project, conn)
    require_registered_project(conn, project)

    from_project = None
    if args.is_request:
        from_project = _resolve_sender_project(conn, project, args.from_project)

    cur = conn.execute(
        "INSERT INTO todos (project, created_at, from_project, body) VALUES (?, ?, ?, ?)",
        (project, resolve_timestamp(args.at), from_project, body),
    )
    conn.commit()
    suffix = f"（from: {from_project}）" if from_project else ""
    print(f"OK: TODO #{cur.lastrowid} を追加しました ({project}){suffix}")


def cmd_add_message(args):
    body = read_body()
    conn = get_conn()
    project = _resolve_project(args.project, conn)
    require_registered_project(conn, project)
    from_project = _resolve_sender_project(conn, project, args.from_project)

    cur = conn.execute(
        "INSERT INTO messages (project, from_project, created_at, body) VALUES (?, ?, ?, ?)",
        (project, from_project, resolve_timestamp(args.at), body),
    )
    conn.commit()
    print(f"OK: MESSAGE #{cur.lastrowid} を追加しました ({project})（from: {from_project}）")


def cmd_finish_todo(args):
    conn = get_conn()
    project = _resolve_project(args.project, conn)
    cur = conn.execute(
        "UPDATE todos SET completed_at = ? WHERE id = ? AND project = ? "
        "AND completed_at IS NULL AND declined_at IS NULL",
        (resolve_timestamp(args.at), args.id, project),
    )
    conn.commit()
    if cur.rowcount == 0:
        print("エラー: 該当する未完了・未見送りのTODOが見つかりません", file=sys.stderr)
        sys.exit(1)
    print(f"OK: TODO #{args.id} ({project}) を完了にしました")


def cmd_decline_todo(args):
    reason = read_body()
    conn = get_conn()
    project = _resolve_project(args.project, conn)
    cur = conn.execute(
        "UPDATE todos SET declined_at = ?, decline_reason = ? WHERE id = ? AND project = ? "
        "AND completed_at IS NULL AND declined_at IS NULL",
        (resolve_timestamp(args.at), reason, args.id, project),
    )
    conn.commit()
    if cur.rowcount == 0:
        print("エラー: 該当する未完了・未見送りのTODOが見つかりません", file=sys.stderr)
        sys.exit(1)
    print(f"OK: TODO #{args.id} ({project}) を見送りにしました")


def _print_todo_list(rows, show_all, show_id):
    """(id, created_at, 完了/既読日時, from_project, body, declined_at, decline_reason)の
    行リストをタスクリスト形式で表示する。

    todo/request/messageで共通（messageはcompleted_at位置にread_atを渡し、
    declined_at/decline_reasonは常にNone。messageに見送りの概念は無いため）。
    表示した件数を返す（0件かどうかの判定を呼び出し元に委ねるため）。
    """
    shown = 0
    for todo_id, created_at, completed_at, from_project, body, declined_at, decline_reason in rows:
        closed = completed_at is not None or declined_at is not None
        if not show_all and closed:
            continue
        mark = "x" if closed else " "
        tag = f" [from: {from_project}]" if from_project else ""
        if declined_at:
            tag += f" (見送り: {decline_reason})"
        # GFMのタスクリスト記法（- [ ]/- [x]）。素の「[ ]」はMarkdown上ただの地の文で、
        # 空行の無い連続行が1段落にmergeされてしまう（mdcat等で確認済み）ため、
        # 各項目が独立したリスト項目として扱われるよう「- 」を必ず付ける。
        header = f"- [{mark}] #{todo_id}{tag}" if show_id else f"- [{mark}]{tag}"
        lines = body.split("\n")
        print(f"{header} {lines[0]}")
        for line in lines[1:]:
            # 継続行はリストマーカー「- 」と同じ幅(2文字)で字下げし、同じ項目の続きとして扱わせる。
            print(f"  {line}")
        if len(lines) > 1:
            print()
        shown += 1
    return shown


def cmd_todos(args):
    conn = get_conn()
    project = _resolve_project(args.project, conn)
    rows = conn.execute(
        "SELECT id, created_at, completed_at, from_project, body, declined_at, decline_reason "
        "FROM todos WHERE project = ? ORDER BY created_at",
        (project,),
    ).fetchall()
    if _print_todo_list(rows, args.all, args.show_id) == 0:
        print(f"（{project} に該当するTODOはありません）")


def cmd_request(args):
    conn = get_conn()
    if args.all_projects and args.project:
        print("エラー: projectと--global/-gは同時に指定できません", file=sys.stderr)
        sys.exit(1)
    if args.all_projects:
        # 横断表示（--global）: 全プロジェクトのrequest（from_projectがあるtodo）を
        # プロジェクトごとにまとめて表示する。対応漏れのチェック用途を想定しているため、
        # 既定は未完了・未見送りのみ（--allで含める）。
        rows = conn.execute(
            "SELECT project, id, created_at, completed_at, from_project, body, "
            "declined_at, decline_reason FROM todos "
            "WHERE from_project IS NOT NULL ORDER BY project, created_at"
        ).fetchall()
        by_project = {}
        for row in rows:
            project, todo_id, created_at, completed_at, from_project, body, declined_at, decline_reason = row
            if not args.all and (completed_at is not None or declined_at is not None):
                continue
            by_project.setdefault(project, []).append(
                (todo_id, created_at, completed_at, from_project, body, declined_at, decline_reason)
            )
        if not by_project:
            print("（該当するREQUESTはありません）")
            return
        for i, project in enumerate(sorted(by_project)):
            if i > 0:
                print()
            print(f"### {project}")
            _print_todo_list(by_project[project], True, args.show_id)
    else:
        project = _resolve_project(args.project, conn)
        rows = conn.execute(
            "SELECT id, created_at, completed_at, from_project, body, declined_at, decline_reason "
            "FROM todos WHERE project = ? AND from_project IS NOT NULL ORDER BY created_at",
            (project,),
        ).fetchall()
        if _print_todo_list(rows, args.all, args.show_id) == 0:
            print(f"（{project} に該当するREQUESTはありません）")


def cmd_message(args):
    conn = get_conn()
    if args.all_projects and args.project:
        print("エラー: projectと--global/-gは同時に指定できません", file=sys.stderr)
        sys.exit(1)
    if args.all_projects:
        # 横断表示（--global）: 全プロジェクトのmessageをプロジェクトごとにまとめて表示する。
        # 既定は未読のみ（--allで既読分も含む）。requestと同じ構造。
        rows = conn.execute(
            "SELECT project, id, created_at, read_at, from_project, body FROM messages "
            "ORDER BY project, created_at"
        ).fetchall()
        by_project = {}
        for project, msg_id, created_at, read_at, from_project, body in rows:
            if not args.all and read_at is not None:
                continue
            # messageにdeclined_at/decline_reasonは無いため、_print_todo_listの
            # 共通シグネチャに合わせてNoneを補う。
            by_project.setdefault(project, []).append(
                (msg_id, created_at, read_at, from_project, body, None, None)
            )
        if not by_project:
            print("（該当するMESSAGEはありません）")
            return
        for i, project in enumerate(sorted(by_project)):
            if i > 0:
                print()
            print(f"### {project}")
            _print_todo_list(by_project[project], True, args.show_id)
    else:
        project = _resolve_project(args.project, conn)
        rows = conn.execute(
            "SELECT id, created_at, read_at, from_project, body FROM messages "
            "WHERE project = ? ORDER BY created_at",
            (project,),
        ).fetchall()
        rows = [(i, c, r, f, b, None, None) for i, c, r, f, b in rows]
        if _print_todo_list(rows, args.all, args.show_id) == 0:
            print(f"（{project} に該当するMESSAGEはありません）")


def _print_or_page(output):
    """TTY出力かつ端末の行数を超える場合のみ$PAGER（既定less）に通す。

    パイプ・リダイレクト時（非TTY）はそのまま標準出力へ書く。
    """
    if sys.stdout.isatty():
        term_lines = shutil.get_terminal_size(fallback=(80, 24)).lines
        if output.count("\n") + 1 > term_lines:
            pager = os.environ.get("PAGER", "less")
            result = subprocess.run(pager, input=output, text=True, shell=True)
            if result.returncode == 0:
                return
            # ページャ起動に失敗した場合はそのまま標準出力へフォールバック
    sys.stdout.write(output)


def _fetch_entries(conn, project, kind, sort_col, ascending, limit,
                    date=None, from_ts=None, to_ts=None):
    """entriesから1プロジェクト分をkind絞り込み・並べ替え・（任意で）件数制限して取得する。

    sort_colはargparseのchoicesで安全な値に限定済みの前提で、そのままSQLへ埋め込む。
    date/from_ts/to_tsを指定すると、created_atに対する絞り込みが追加される
    （複数指定時はAND合成。詳細は_build_date_filter参照）。
    """
    direction = "ASC" if ascending else "DESC"
    query = "SELECT id, created_at, body FROM entries WHERE project = ? AND kind = ?"
    params = [project, kind]
    conditions, extra_params = _build_date_filter(date, from_ts, to_ts)
    for condition in conditions:
        query += f" AND {condition}"
    params.extend(extra_params)
    query += f" ORDER BY {sort_col} {direction}"
    if limit is not None:
        query += " LIMIT ?"
        params.append(limit)
    return conn.execute(query, params).fetchall()


def _format_dated_entries(title, rows, show_id=False):
    parts = [title, ""]
    for entry_id, created_at, body in rows:
        heading = f"## {created_at} (#{entry_id})" if show_id else f"## {created_at}"
        parts.append(heading)
        parts.append("")
        parts.append(body.strip())
        parts.append("")
    return "\n".join(parts).rstrip("\n") + "\n"


def _preview_paragraph(body, limit=400):
    """本文から冒頭のプレビューを切り出す。(テキスト, 切り詰めたか) を返す。

    空行区切りの段落を先頭から拾い、実質的な内容（見出しではない行）を
    含む段落が現れるまでは見出しごと含めて進める（見出しだけの段落が
    単独でプレビューになってしまう＝中身が見えない、という事態を防ぐため）。
    そこまででlimit文字以内に収まればそれを使う。見つからない・長すぎる
    場合はlimit文字付近の文末（「。」）で切る。
    """
    body = body.strip()
    paragraphs = body.split("\n\n")
    included = []
    for para in paragraphs:
        included.append(para)
        has_content = any(
            line.strip() and not re.match(r"^#{1,6}\s", line)
            for line in para.split("\n")
        )
        if has_content:
            break
    preview = "\n\n".join(included).strip()
    if len(preview) <= limit:
        return preview, len(preview) < len(body)
    cut = body.rfind("。", 0, limit)
    cut = cut + 1 if cut != -1 else limit
    return body[:cut].strip(), True


def _cmd_summary_cross(args, conn, date=None, from_ts=None, to_ts=None):
    """summaryの横断表示（project省略時）: 全プロジェクトの最新SUMMARYを1件ずつ。

    date/--from/--toのいずれか指定時は「最新1件」ロジックをやめ、絞り込み条件
    （複数指定時はAND合成）に該当するSUMMARYを持つプロジェクトについて、その記録を
    全件表示する（「その期間にやったこと」を横断的に振り返る用途。外部連携での
    日次抽出等を想定）。
    """
    direction = "ASC" if args.asc else "DESC"
    if date or from_ts or to_ts:
        conditions, params = _build_date_filter(date, from_ts, to_ts)
        where_clause = " AND ".join(["kind = 'summary'"] + conditions)
        # sortがprojectの場合のみ副次キーとしてcreated_atを足す（同一プロジェクト内の
        # 複数件を時系列順に並べるため）。created_atの場合は二重指定を避ける。
        secondary = ", created_at" if args.sort == "project" else ""
        rows = conn.execute(
            f"""
            SELECT project, created_at, body FROM entries
            WHERE {where_clause}
            ORDER BY {args.sort} {direction}{secondary}
            """,
            params,
        ).fetchall()
    else:
        rows = conn.execute(
            f"""
            SELECT e.project, e.created_at, e.body
            FROM entries e
            WHERE e.kind = 'summary'
              AND e.id = (
                  -- created_atは秒精度のため同一project内で複数件が同じ値を
                  -- 持ちうる。idは挿入順で必ず一意なので、created_at→idの順で
                  -- タイブレークし、1projectにつき必ず1行だけ選ぶ。
                  SELECT e2.id FROM entries e2
                  WHERE e2.project = e.project AND e2.kind = 'summary'
                  ORDER BY e2.created_at DESC, e2.id DESC
                  LIMIT 1
              )
            ORDER BY {args.sort} {direction}
            """
        ).fetchall()
    if not rows:
        print("(記録なし)")
        return

    is_tty = sys.stdout.isatty()
    parts = ["# collog summary", ""]
    for project, created_at, body in rows:
        parts.append(f"## [{created_at}] {project}")
        parts.append("")
        if is_tty:
            text, truncated = _preview_paragraph(body)
            if truncated:
                text += " …"
        else:
            text = body.strip()
        parts.append(text)
        parts.append("")
    _print_or_page("\n".join(parts).rstrip("\n") + "\n")


def _cmd_entry_history(args, conn, kind, date=None, from_ts=None, to_ts=None):
    """summary/change共通の1プロジェクト分の履歴表示。

    既定の並べ替え方向はkindごとに異なる（changeは元々「古い順」、summaryは
    「新しい順」）ため、--asc/--desc未指定時はargs.default_ascendingに従う。
    date/from_ts/to_tsのいずれかを指定すると、それらに絞り込む（複数指定時は
    AND合成）。この時-n（未明示なら）は無視して全件表示する（絞り込んだ上に
    件数でも切られると記録が漏れてしまうため）。-nが明示的に指定されていれば
    そちらを優先する。
    """
    project = _resolve_project(args.project, conn)
    if args.asc:
        ascending = True
    elif args.desc:
        ascending = False
    else:
        ascending = args.default_ascending
    narrowed = date or from_ts or to_ts
    if args.n is not None:
        limit = args.n
    elif narrowed:
        limit = None
    else:
        limit = args.default_n
    rows = _fetch_entries(conn, project, kind, args.sort, ascending, limit,
                           date=date, from_ts=from_ts, to_ts=to_ts)
    if not rows:
        label = f"{project}" if not narrowed else f"{project}（絞り込み条件に該当なし）"
        print(f"(記録なし: {label})", file=sys.stderr)
        return
    if args.reverse:
        rows = list(reversed(rows))
    _print_or_page(_format_dated_entries(
        f"# collog {kind}: {project}", rows, show_id=args.show_id
    ))


def cmd_summary(args):
    conn = get_conn()
    date = validate_date(args.date)
    from_ts = validate_boundary_timestamp(args.date_from, "--from")
    to_ts = validate_boundary_timestamp(args.date_to, "--to")
