def cmd_export(args):
    conn = get_conn()
    if args.project:
        if conn.execute(
            "SELECT 1 FROM projects WHERE name = ?", (args.project,)
        ).fetchone() is None:
            print(f"エラー: プロジェクト '{args.project}' は未登録です。", file=sys.stderr)
            sys.exit(1)
        project_rows = conn.execute(
            "SELECT name, path, created_at, updated_at FROM projects WHERE name = ?",
            (args.project,),
        ).fetchall()
        entry_rows = conn.execute(
            "SELECT id, project, kind, created_at, body FROM entries WHERE project = ? ORDER BY id",
            (args.project,),
        ).fetchall()
        todo_rows = conn.execute(
            "SELECT id, project, created_at, completed_at, from_project, body, "
            "declined_at, decline_reason FROM todos WHERE project = ? ORDER BY id",
            (args.project,),
        ).fetchall()
        message_rows = conn.execute(
            "SELECT id, project, from_project, created_at, read_at, body "
            "FROM messages WHERE project = ? ORDER BY id",
            (args.project,),
        ).fetchall()
    else:
        project_rows = conn.execute(
            "SELECT name, path, created_at, updated_at FROM projects ORDER BY name"
        ).fetchall()
        entry_rows = conn.execute(
            "SELECT id, project, kind, created_at, body FROM entries ORDER BY id"
        ).fetchall()
        todo_rows = conn.execute(
            "SELECT id, project, created_at, completed_at, from_project, body, "
            "declined_at, decline_reason FROM todos ORDER BY id"
        ).fetchall()
        message_rows = conn.execute(
            "SELECT id, project, from_project, created_at, read_at, body "
            "FROM messages ORDER BY id"
        ).fetchall()

    data = {
        "collog_export_version": 1,
        "exported_at": now(),
        "projects": [
            {"name": n, "path": p, "created_at": c, "updated_at": u}
            for n, p, c, u in project_rows
        ],
        "entries": [
            {"id": i, "project": pr, "kind": k, "created_at": c, "body": b}
            for i, pr, k, c, b in entry_rows
        ],
        "todos": [
            {
                "id": i, "project": pr, "created_at": c,
                "completed_at": ca, "from_project": fp, "body": b,
                "declined_at": da, "decline_reason": dr,
            }
            for i, pr, c, ca, fp, b, da, dr in todo_rows
        ],
        "messages": [
            {
                "id": i, "project": pr, "from_project": fp,
                "created_at": c, "read_at": ra, "body": b,
            }
            for i, pr, fp, c, ra, b in message_rows
        ],
    }
    # ensure_ascii=False: 日本語本文が\uXXXXにエスケープされて読みにくくなるのを防ぐ
    # （正しさには影響しない、可読性だけの話）。
    print(json.dumps(data, ensure_ascii=False, indent=2))


def cmd_import(args):
    raw = sys.stdin.read()
    if not raw.strip():
        print("エラー: 標準入力からJSONを読み込めませんでした（空です）", file=sys.stderr)
        sys.exit(1)
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"エラー: JSONの解析に失敗しました: {e}", file=sys.stderr)
        sys.exit(1)

    conn = get_conn()
    projects_in = data.get("projects", [])
    entries_in = data.get("entries", [])
    todos_in = data.get("todos", [])
    messages_in = data.get("messages", [])

    # INSERTを始める前に、entries/todos/messagesが参照するprojectが「既に登録済み」か
    # 「このimportデータのprojectsに含まれている」かを検証する（不整合な取り込みを防ぐ）。
    known_projects = {row[0] for row in conn.execute("SELECT name FROM projects")}
    known_projects |= {p["name"] for p in projects_in}
    for e in entries_in:
        if e["project"] not in known_projects:
            print(
                f"エラー: entriesが参照するプロジェクト '{e['project']}' が未登録で、"
                f"importデータのprojectsにも含まれていません。",
                file=sys.stderr,
            )
            sys.exit(1)
    for t in todos_in:
        for key in ("project", "from_project"):
            name = t.get(key)
            if name and name not in known_projects:
                print(
                    f"エラー: todosが参照するプロジェクト '{name}'（{key}）が未登録で、"
                    f"importデータのprojectsにも含まれていません。",
                    file=sys.stderr,
                )
                sys.exit(1)
    for m in messages_in:
        for key in ("project", "from_project"):
            name = m.get(key)
            if name and name not in known_projects:
                print(
                    f"エラー: messagesが参照するプロジェクト '{name}'（{key}）が未登録で、"
                    f"importデータのprojectsにも含まれていません。",
                    file=sys.stderr,
                )
                sys.exit(1)

    # --safety指定時はプレーンなINSERT（重複はエラーで中断）、デフォルトはINSERT OR REPLACEで
    # 「exportした内容がそのまま入る」を優先する（mysql < backup.dmp と同じ考え方）。
    insert_or = "" if args.safety else "OR REPLACE "
    ts = now()
    try:
        with conn:
            projects_created = 0
            for proj in projects_in:
                name = proj["name"]
                is_new = not conn.execute(
                    "SELECT 1 FROM projects WHERE name = ?", (name,)
                ).fetchone()
                path = proj.get("path") or os.getcwd()
                conn.execute(
                    f"INSERT {insert_or}INTO projects (name, path, created_at, updated_at) "
                    "VALUES (?, ?, ?, ?)",
                    (name, path, proj.get("created_at", ts), proj.get("updated_at", ts)),
                )
                if is_new:
                    projects_created += 1
                if not os.path.isdir(path):
                    print(f"警告: プロジェクト '{name}' のパス '{path}' はディレクトリとして存在しません",
                          file=sys.stderr)

            for e in entries_in:
                if e.get("id") is not None:
                    conn.execute(
                        f"INSERT {insert_or}INTO entries (id, project, kind, created_at, body) "
                        "VALUES (?, ?, ?, ?, ?)",
                        (e["id"], e["project"], e["kind"], e["created_at"], e["body"]),
                    )
                else:
                    conn.execute(
                        "INSERT INTO entries (project, kind, created_at, body) VALUES (?, ?, ?, ?)",
                        (e["project"], e["kind"], e["created_at"], e["body"]),
                    )

            for t in todos_in:
                if t.get("id") is not None:
                    conn.execute(
                        f"INSERT {insert_or}INTO todos "
                        "(id, project, created_at, completed_at, from_project, body, "
                        "declined_at, decline_reason) "
                        "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                        (t["id"], t["project"], t["created_at"], t.get("completed_at"),
                         t.get("from_project"), t["body"], t.get("declined_at"),
                         t.get("decline_reason")),
                    )
                else:
                    conn.execute(
                        "INSERT INTO todos (project, created_at, completed_at, from_project, "
                        "body, declined_at, decline_reason) VALUES (?, ?, ?, ?, ?, ?, ?)",
                        (t["project"], t["created_at"], t.get("completed_at"),
                         t.get("from_project"), t["body"], t.get("declined_at"),
                         t.get("decline_reason")),
                    )

            for m in messages_in:
                if m.get("id") is not None:
                    conn.execute(
                        f"INSERT {insert_or}INTO messages "
                        "(id, project, from_project, created_at, read_at, body) "
                        "VALUES (?, ?, ?, ?, ?, ?)",
                        (m["id"], m["project"], m.get("from_project"), m["created_at"],
                         m.get("read_at"), m["body"]),
                    )
                else:
                    conn.execute(
                        "INSERT INTO messages (project, from_project, created_at, read_at, body) "
                        "VALUES (?, ?, ?, ?, ?)",
                        (m["project"], m.get("from_project"), m["created_at"],
                         m.get("read_at"), m["body"]),
                    )
    except sqlite3.IntegrityError as ex:
        print(f"エラー: ID/name重複のため中断しました（--safety指定時はREPLACEされません）: {ex}",
              file=sys.stderr)
        sys.exit(1)

    print(
        f"OK: インポート完了 (projects: {projects_created}件新規登録, "
        f"entries: {len(entries_in)}件, todos: {len(todos_in)}件, messages: {len(messages_in)}件)"
    )


def _match_snippet(body, keyword, context=80):
    """本文中でkeywordが最初に現れる位置の前後を切り出す（大小文字は区別しない）。

    改行等の空白は1つに畳んで1行のスニペットにする。前後が切れている場合は'…'を付ける。
    """
    idx = body.lower().find(keyword.lower())
    if idx == -1:
        # 呼び出し元でヒット確認済みの前提だが、念のためのフォールバック。
        return " ".join(body.strip().split())[: context * 2]
    start = max(0, idx - context)
    end = min(len(body), idx + len(keyword) + context)
    snippet = " ".join(body[start:end].split())
    prefix = "…" if start > 0 else ""
    suffix = "…" if end < len(body) else ""
    return f"{prefix}{snippet}{suffix}"


def cmd_search(args):
    conn = get_conn()
    if args.all_projects and args.project:
        print("エラー: projectと--global/-gは同時に指定できません", file=sys.stderr)
        sys.exit(1)
    project = None if args.all_projects else _resolve_project(args.project, conn)

    keyword_lower = args.keyword.lower()
    kinds = [args.kind] if args.kind else ["summary", "change", "todo"]
    matches = []  # (created_at, header, snippet)

    entry_kinds = [k for k in kinds if k in ("summary", "change")]
    if entry_kinds:
        placeholders = ",".join("?" * len(entry_kinds))
        query = f"SELECT id, created_at, kind, project, body FROM entries WHERE kind IN ({placeholders})"
        params = list(entry_kinds)
        if project:
            query += " AND project = ?"
            params.append(project)
        for entry_id, created_at, kind, project_name, body in conn.execute(query, params).fetchall():
            if keyword_lower in body.lower():
                header = f"## [{created_at}] {project_name} ({kind} #{entry_id})"
                matches.append((created_at, header, _match_snippet(body, args.keyword)))

    if "todo" in kinds:
        query = ("SELECT id, created_at, completed_at, from_project, project, body, "
                  "declined_at FROM todos")
        params = []
        if project:
            query += " WHERE project = ?"
            params.append(project)
        for todo_id, created_at, completed_at, from_project, project_name, body, declined_at \
                in conn.execute(query, params).fetchall():
            if keyword_lower in body.lower():
                mark = "x" if (completed_at or declined_at) else " "
                tag = f" from: {from_project}" if from_project else ""
                header = f"## [{created_at}] {project_name} (todo #{todo_id} [{mark}]{tag})"
                matches.append((created_at, header, _match_snippet(body, args.keyword)))

    if not matches:
        print(f"（'{args.keyword}' に一致する記録はありません）")
        return

    matches.sort(key=lambda m: m[0], reverse=True)
    parts = [f"# collog search: {args.keyword}", ""]
    for _, header, snippet in matches:
        parts.append(header)
        parts.append("")
        parts.append(snippet)
        parts.append("")
    _print_or_page("\n".join(parts).rstrip("\n") + "\n")


def cmd_help(args):
    target = args._parser
    subparsers_action = args._subparsers
    for name in args.command:
        if subparsers_action is None or name not in subparsers_action.choices:
            print(f"エラー: 不明なサブコマンドです: {' '.join(args.command)}", file=sys.stderr)
            sys.exit(1)
        target = subparsers_action.choices[name]
        subparsers_action = _find_subparsers_action(target)
    target.print_help()


def _find_subparsers_action(parser):
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            return action
    return None


def _add_parser_with_hidden_aliases(subparsers_action, name, aliases=(), **kwargs):
    """add_parserと同じだが、aliasesを一覧・usage表示には出さず、入力としてのみ受け付ける。

    argparseの標準aliases=は"todos (todo)"のようにヘルプへ表示してしまうため、
    正式なサブコマンド名だけを提示したい場合に使う。エイリアスは
    _name_parser_map（サブコマンド名解決に使われる辞書）へ直接追加するだけで、
    ヘルプ表示に使われる_choices_actionsには載せない。
    """
    parser = subparsers_action.add_parser(name, **kwargs)
    for alias in aliases:
        subparsers_action._name_parser_map[alias] = parser
    return parser


def _add_project_arg(p, help_text):
    """省略可能なproject引数と、その代わりにディレクトリで指定する--pathを追加する。"""
    p.add_argument("project", nargs="?", default=None, help=help_text)
    p.add_argument("--path", dest="project_path", default=None, metavar="DIR",
                    help="projectの代わりにディレクトリで指定する"
                         "（登録パスと完全一致。projectとは同時指定不可）")


