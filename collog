def main():
    parser = build_parser()
    args = parser.parse_args()
    # --pathはここでプロジェクト名に変換してargs.projectに入れる（各コマンドの処理は
    # args.projectを読むだけで済むようにするため）。
    if getattr(args, "project_path", None) is not None:
        if args.project is not None:
            print("エラー: projectと--pathは同時に指定できません", file=sys.stderr)
            sys.exit(1)
        args.project = _project_at(args.project_path, get_conn())
        if args.project is None:
            print(f"エラー: パス '{args.project_path}' に一致する登録済みプロジェクトがありません",
                  file=sys.stderr)
            sys.exit(1)
    args.func(args)


if __name__ == "__main__":
    main()
